<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_shield"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <ImageView
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_divider" />

            <LinearLayout
                android:id="@+id/widget_brand_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="UAC"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_vpn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.32"
                    android:text="VPN"
                    android:textColor="#FF8A99AD"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/widget_engine_xray"
                    android:layout_width="50dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp">

                    <ImageView
                        android:id="@+id/widget_engine_xray_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/widget_engine_xray_label"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="XRAY"
                        android:textColor="#FFFFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_engine_tor"
                    android:layout_width="42dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp">

                    <ImageView
                        android:id="@+id/widget_engine_tor_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/widget_engine_tor_label"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="TOR"
                        android:textColor="#FF8A99AD"
                        android:textSize="10sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_engine_pow"
                    android:layout_width="44dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp">

                    <ImageView
                        android:id="@+id/widget_engine_pow_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/widget_engine_pow_label"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="PoW"
                        android:textColor="#FF8A99AD"
                        android:textSize="10sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_engine_direct"
                    android:layout_width="58dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/widget_engine_direct_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/widget_engine_direct_label"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="DIRECT"
                        android:textColor="#FF8A99AD"
                        android:textSize="9sp" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/widget_ping_card"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/widget_glass_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp">

                        <ImageView
                            android:id="@+id/widget_ping_icon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="Ping"
                                android:textColor="#FF9FB4C8"
                                android:textSize="8sp" />

                            <TextView
                                android:id="@+id/widget_ping_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="—"
                                android:textColor="#FFFFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_country_card"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/widget_glass_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingEnd="5dp">

                        <ImageView
                            android:id="@+id/widget_globe_icon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="Country"
                                android:textColor="#FF9FB4C8"
                                android:textSize="8sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/widget_country_flag"
                                    android:layout_width="12dp"
                                    android:layout_height="9dp"
                                    android:layout_marginEnd="3dp"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/widget_country_name"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif"
                                    android:includeFontPadding="false"
                                    android:singleLine="true"
                                    android:text="—"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:text="›"
                            android:textColor="#FF7FE8FF"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/widget_down_card"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/widget_glass_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp">

                        <ImageView
                            android:id="@+id/widget_down_icon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="Download"
                                android:textColor="#FF9FB4C8"
                                android:textSize="8sp" />

                            <TextView
                                android:id="@+id/widget_down_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="—"
                                android:textColor="#FFFFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_up_card"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/widget_glass_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp">

                        <ImageView
                            android:id="@+id/widget_up_icon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="Upload"
                                android:textColor="#FF9FB4C8"
                                android:textSize="8sp" />

                            <TextView
                                android:id="@+id/widget_up_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="—"
                                android:textColor="#FFFFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/widget_status_pill"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/widget_status_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="وصل است"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/widget_signal"
                android:layout_width="16dp"
                android:layout_height="13dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
